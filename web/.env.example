# Variables d'environnement du site. Copier en .env.local (local) ou les saisir dans
# Vercel › Settings › Environment Variables (Production). Aucune valeur secrète ici.

# --- CJ Dropshipping (type Secret) ---
# Clé API de l'espace CJ, format CJ…@api@…
CJ_API_KEY=
# Jeton d'accès CJ (180 jours) : évite de le redemander à chaque démarrage
CJ_ACCESS_TOKEN=
# Transmission des commandes : sandbox (test), live (réel) ou off. « live » ne s'active
# qu'avec une clé Mepaye mp_live_.
CJ_ORDER_MODE=sandbox
# Facultatif : TVA à l'import hors UE, 3 = IOSS de CJ (par défaut)
# CJ_IOSS_TYPE=3

# --- Paiement Mepaye (type Secret) ---
# Clé de paiement : mp_live_… (réel) ou mp_test_… (test)
MEPAYE_API_KEY=
# Secret du webhook https://<projet>.vercel.app/api/payments/notify, valeur complète whsec_…
MEPAYE_WEBHOOK_SECRET=

# --- E-mails (boîte LWS contact@<domaine>) ---
# Vrai serveur LWS (par exemple mailNN.lwspanel.com), pas mail.<domaine> (type Config)
SMTP_HOST=
SMTP_PORT=465
# Adresse de la boîte (type Config) et son mot de passe (type Secret)
SMTP_USER=
SMTP_PASSWORD=
# Local seulement : écrit les e-mails dans ce dossier au lieu de les envoyer
# EMAIL_OUTBOX_DIR=data/outbox

# --- Administration et tâches (type Secret) ---
ADMIN_PASSWORD=
# 64 caractères hexadécimaux : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
# Secret de la tâche planifiée /api/cj/sync (Authorization: Bearer …)
CRON_SECRET=

# --- Site (type Config) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Base de données ---
# En local : fichier data/boutique.db, rien à régler. En production : Vercel › Storage ›
# Turso, préfixe DATABASE, qui ajoute DATABASE_TURSO_DATABASE_URL et DATABASE_TURSO_AUTH_TOKEN.
